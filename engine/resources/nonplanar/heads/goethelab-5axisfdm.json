{
  "schema": "orca.head_envelope.v1",
  "id": "goethelab-5axisfdm",
  "name": "GoetheLab 5axisFDM (Prusa MK3S head, UV tilt-rotary table)",
  "provenance": "GoetheLab (FH Aachen) 5axisFDM: Prusa i3 MK3S extruder over a tilt-rotary table, from the lab's 5axisFDM viewer meshes. extruder.stl (SHA256 931967fbee7526d16719ca76efd9894d5ee7bc2cfc8d520e3381d757f6e8cd0e) is turned upright with Rx(+90 deg) as in machine_mesh.py and moved so the nozzle tip (lowest point) is the origin; each box is the exact extent of the mesh surface clipped to its Z band and Y strip (0.25-0.5 mm bands to Z 6 mm, marked nozzle, then 1-10 mm bands), rounded outward to 0.001 mm. Table obstacles: rotary_table.stl (SHA256 634081f0988cb6d249e29dcb7a9760cb63c48533dac8c2eb8cbe08d626075cbf) in the table frame (turns with U and V), cradle.stl (SHA256 92e7b8cb788bac268ad838227441c832f1bfb45168931a415bdcaeba66bdaff3) in the cradle frame (turns with U only), both turned by Rz(-90 deg) as in machine_mesh.py, origin at the plate centre on its surface where the tilt and turntable axes cross; plate top at Z 0. frame.stl (SHA256 645717eb7293f0cde15f48ff9d8e9ac762130ef3625a122eb072bd6f33816647) is fixed to the Y stage and does not tilt; the envelope cannot carry a non-tilting obstacle, so it is not modelled (top Z 13.1 mm, below the cradle arms). Body axial/lateral margins 0.3 mm. Nozzle-tip frame +X right, +Y rear, +Z up, mm. Not calibrated.",
  "calibrated": false,
  "nozzle": {"tip_flat_radius": 0.5, "allowance_radius": 3.0, "allowance_height": 1.0},
  "margin": 0.3,
  "lateral_margin": 0.3,
